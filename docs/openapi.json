    "/webhook/modelo/v1/politicas/processar": {
      "post": {
        "summary": "Processar politica",
        "security": [
          {
            "integrationBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "clientId",
                  "requestId",
                  "policyVersion",
                  "arquivo",
                  "action"
                ],
                "properties": {
                  "clientId": {
                    "type": "string",
                    "pattern": "^(?:[1-9][0-9]{2}|1000)$"
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "policyVersion": {
                    "type": "string"
                  },
                  "arquivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "create",
                      "update"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recebido; guardar recibo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recibo"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token inválido"
          },
          "403": {
            "description": "Empresa fora da faixa"
          },
          "409": {
            "description": "Duplicata"
          },
          "413": {
            "description": "Limite excedido"
          },
          "415": {
            "description": "Formato inválido"
          },
          "502": {
            "description": "Falha upstream"
          },
          "503": {
            "description": "Indisponível"
          }
        }
      }
    },
    "/webhook/modelo/v1/despesas/analisar": {
      "post": {
        "summary": "Processar despesa",
        "security": [
          {
            "integrationBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "clientId",
                  "requestId",
                  "policyVersion",
                  "arquivo",
                  "politicaJson"
                ],
                "properties": {
                  "clientId": {
                    "type": "string",
                    "pattern": "^(?:[1-9][0-9]{2}|1000)$"
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "policyVersion": {
                    "type": "string"
                  },
                  "arquivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "politicaJson": {
                    "type": "string",
                    "description": "JSON.stringify do catálogo integral aprovado"
                  },
                  "vendedorId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recebido; guardar recibo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recibo"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token inválido"
          },
          "403": {
            "description": "Empresa fora da faixa"
          },
          "409": {
            "description": "Duplicata"
          },
          "413": {
            "description": "Limite excedido"
          },
          "415": {
            "description": "Formato inválido"
          },
          "502": {
            "description": "Falha upstream"
          },
          "503": {
            "description": "Indisponível"
          }
        }
      }
    },
