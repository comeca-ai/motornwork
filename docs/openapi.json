  "components": {
    "securitySchemes": {
      "integrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token central do backend"
      },
      "resultBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "resultToken do recibo"
      }
    },
    "schemas": {
      "Recibo": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "clientId",
          "requestId",
          "policyVersion",
          "resultUrl",
          "resultToken"
        ],
        "properties": {
          "id": {
            "type": "string"
